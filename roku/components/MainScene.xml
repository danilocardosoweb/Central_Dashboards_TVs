                        font="font:LargeBoldSystemFont" />
                    <Label id="pprPeriod" translation="[1430,82]" width="390" height="58"
                        horizAlign="center" color="0x1E40AFFF" font="font:MediumBoldSystemFont" />

                    <Group id="pprThermometerGroup" visible="false">
                        <Rectangle id="pprThermometerTrack" translation="[174,260]" width="112" height="620" color="0xFFFFFFFF" />
                        <Rectangle id="pprThermometerFill" translation="[186,868]" width="88" height="0" color="0x22C55EFF" />
                        <Rectangle id="pprBulbTrack" translation="[148,858]" width="164" height="164" color="0xFFFFFFFF" />
                        <Rectangle id="pprBulb" translation="[164,874]" width="132" height="132" color="0x22C55EFF" />
                        <Label id="pprScale150" translation="[315,244]" width="520" height="45" text="150%" color="0x475569FF" font="font:MediumSystemFont" />
                        <Label id="pprScale125" translation="[315,345]" width="520" height="45" text="125%" color="0x475569FF" font="font:MediumSystemFont" />
                        <Label id="pprScale100" translation="[315,448]" width="520" height="52" text="100%  META" color="0x0F172AFF" font="font:MediumBoldSystemFont" />
                        <Label id="pprScale75" translation="[315,551]" width="520" height="45" text="75%" color="0x475569FF" font="font:MediumSystemFont" />
                        <Label id="pprScale50" translation="[315,654]" width="520" height="45" text="50%" color="0x475569FF" font="font:MediumSystemFont" />
                        <Label id="pprScale0" translation="[315,848]" width="520" height="45" text="0%" color="0x475569FF" font="font:MediumSystemFont" />
                    </Group>

                    <Label id="pprValueCaption" translation="[650,278]" width="1050" height="42"
                        text="DESEMPENHO ATUAL" color="0x2563EBFF" font="font:MediumBoldSystemFont" />
                    <Label id="pprValue" translation="[650,320]" width="1050" height="150"
                        color="0x0F172AFF" font="font:LargeBoldSystemFont" />
                    <Label id="pprGoalContext" translation="[650,462]" width="1080" height="48"
