                    <Label id="pprName" translation="[650,522]" width="1080" height="82" wrap="true"
                        color="0x0F172AFF" font="font:LargeBoldSystemFont" />
                    <Label id="pprDescription" translation="[650,612]" width="1080" height="90" wrap="true"
                        color="0x64748BFF" font="font:MediumSystemFont" />
                    <Rectangle id="pprProgressTrack" translation="[650,718]" width="1020" height="12" color="0xCBD5E1FF" />
                    <Rectangle id="pprProgressFill" translation="[650,718]" width="0" height="12" color="0x2563EBFF" />
                    <Rectangle id="pprStatusBackground" translation="[650,756]" width="1020" height="86" color="0x166534FF" />
                    <Label id="pprStatus" translation="[684,775]" width="950" height="52"
                        color="0xFFFFFFFF" font="font:MediumBoldSystemFont" />
                    <Label id="pprDetails" translation="[650,865]" width="1080" height="90" wrap="true"
                        color="0x94A3B8FF" font="font:MediumSystemFont" />

                    <Group id="pprSummaryGroup" visible="false">
                        <Rectangle id="pprSummaryScoreCard" translation="[92,250]" width="430" height="220" color="0xFFFFFFFF" />
                        <Rectangle id="pprSummaryTotalCard" translation="[548,250]" width="390" height="220" color="0xFFFFFFFF" />
                        <Rectangle id="pprSummaryReachedCard" translation="[964,250]" width="390" height="220" color="0xFFFFFFFF" />
                        <Rectangle id="pprSummaryAttentionCard" translation="[1380,250]" width="390" height="220" color="0xFFFFFFFF" />
                        <Label translation="[124,278]" width="360" height="40" text="ÍNDICE CONSOLIDADO" color="0x64748BFF" font="font:MediumBoldSystemFont" />
                        <Label id="pprSummaryAverage" translation="[124,326]" width="360" height="105" color="0x2563EBFF" font="font:LargeBoldSystemFont" />
