                        <Label id="pprSummaryTotal" translation="[580,326]" width="320" height="105" color="0x0F172AFF" font="font:LargeBoldSystemFont" />
                        <Label translation="[996,278]" width="320" height="40" text="META ATINGIDA" color="0x64748BFF" font="font:MediumBoldSystemFont" />
                        <Label id="pprSummaryReached" translation="[996,326]" width="320" height="105" color="0x22C55EFF" font="font:LargeBoldSystemFont" />
                        <Label translation="[1412,278]" width="320" height="40" text="PONTOS DE ATENÇÃO" color="0x64748BFF" font="font:MediumBoldSystemFont" />
                        <Label id="pprSummaryAttention" translation="[1412,326]" width="320" height="105" color="0xF59E0BFF" font="font:LargeBoldSystemFont" />
                        <Rectangle id="pprSummaryListCard" translation="[92,500]" width="1678" height="460" color="0xFFFFFFFF" />
                        <Label translation="[130,530]" width="1600" height="42" text="RESULTADOS DO PERÍODO" color="0x2563EBFF" font="font:MediumBoldSystemFont" />
                        <Label id="pprSummaryList" translation="[130,590]" width="1600" height="325" wrap="true" color="0x334155FF" font="font:MediumSystemFont" />
                    </Group>
                </Group>
            </Group>

            <Group id="bannerGroup" translation="[0,900]" visible="false">
                <Rectangle id="bannerBackground" width="1920" height="180" color="0xC2410CFA" />
                <Label
                    id="bannerTitle"
                    translation="[72,28]"
                    width="450"
                    height="55"
                    color="0xFFFFFFFF"
                    font="font:MediumBoldSystemFont" />
                <Label
                    id="bannerBody"
                    translation="[520,25]"
                    width="1320"
                    height="120"
                    wrap="true"
                    color="0xFFFFFFFF"
                    font="font:MediumSystemFont" />
            </Group>

            <Group id="statusGroup" visible="false">
                <Rectangle translation="[0,0]" width="1920" height="66" color="0x050B14E8" />
                <Label
                    id="stationLabel"
                    translation="[42,14]"
                    width="800"
                    height="42"
                    color="0xF8FAFCFF"
                    font="font:MediumBoldSystemFont" />
                <Label
                    id="syncLabel"
                    translation="[930,14]"
                    width="930"
                    height="42"
                    horizAlign="right"
                    color="0x94A3B8FF"
                    font="font:MediumSystemFont" />
            </Group>

            <Group id="stationOverlay" visible="false">
                <Rectangle width="1920" height="1080" color="0x050B14F8" />
                <Rectangle translation="[340,150]" width="1240" height="780" color="0x111D31FF" />
                <Label
                    translation="[420,215]"
                    width="1080"
                    height="72"
                    text="Escolha o setor desta TV"
                    color="0xF8FAFCFF"
                    font="font:LargeBoldSystemFont" />
                <Label
                    id="stationHelp"
                    translation="[420,300]"
                    width="1080"
                    height="64"
                    text="Use as setas e pressione OK. Para trocar depois, pressione OK ou *."
                    color="0x94A3B8FF"
                    font="font:MediumSystemFont" />
                <LabelList
                    id="stationList"
                    translation="[420,390]"
                    itemSize="[1080,72]"
                    numRows="6"
                    width="1080"
                    height="430"
                    color="0xE2E8F0FF"
                    focusedColor="0xFFFFFFFF"
                    focusBitmapUri="pkg:/images/focus-row.png"
                    vertFocusAnimationStyle="floatingFocus" />
                <Label
                    translation="[420,850]"
                    width="1080"
                    height="42"
                    text="A estação fica salva somente nesta TV."
                    color="0x64748BFF"
                    font="font:SmallSystemFont" />
            </Group>

            <BusySpinner
                id="loading"
                translation="[900,490]"
                posterUri="pkg:/images/spinner.png"
                control="stop" />

            <Group id="introGroup" visible="true">
                <Rectangle width="1920" height="1080" color="0x000000FF" />
                <Video
                    id="introVideo"
                    width="1920"
                    height="1080"
                    visible="true"
                    loop="false"
                    notificationInterval="1"
                    enableUI="false" />
            </Group>

            <Group id="diagnosticsOverlay" visible="false">
                <Rectangle translation="[50,50]" width="1820" height="300" color="0x050B14F4" />
                <Label id="diagnosticsTitle" translation="[90,78]" width="1720" height="48"
                    text="DIAGNOSTICO DO PLAYER" color="0x60A5FAFF" font="font:MediumBoldSystemFont" />
                <Label id="diagnosticsText" translation="[90,138]" width="1720" height="185"
                    wrap="true" color="0xE2E8F0FF" font="font:MediumSystemFont" />
            </Group>

            <Timer id="slideTimer" repeat="false" />
            <Timer id="syncTimer" duration="60" repeat="true" />
            <Timer id="transitionTimer" repeat="false" />
            <Timer id="imageLoadTimer" duration="8" repeat="false" />
            <Timer id="introFallbackTimer" duration="12" repeat="false" />
            <Timer id="fetchWatchdogTimer" duration="20" repeat="false" />
            <Animation id="fadeIn" duration="0.75" easeFunction="outQuad">
                <FloatFieldInterpolator
                    key="[0.0,1.0]"
                    keyValue="[0.0,1.0]"
                    fieldToInterp="contentGroup.opacity" />
            </Animation>
            <Animation id="imageEnter" duration="1.4" easeFunction="inOutQuad">
                <FloatFieldInterpolator
                    id="imageEnterOpacity"
                    key="[0.0,1.0]"
                    keyValue="[0.0,1.0]"
                    fieldToInterp="dashboardImageB.opacity" />
                <Vector2DFieldInterpolator
                    id="imageEnterTranslation"
                    key="[0.0,1.0]"
                    keyValue="[[0.0,0.0],[0.0,0.0]]"
                    fieldToInterp="dashboardImageB.translation" />
                <Vector2DFieldInterpolator
                    id="imageEnterScale"
                    key="[0.0,1.0]"
                    keyValue="[[1.0,1.0],[1.0,1.0]]"
                    fieldToInterp="dashboardImageB.scale" />
            </Animation>
        </Group>
    </children>
</component>
