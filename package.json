{
  "name": "central-dashboards-tvs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "capture:once": "node renderer/capture.mjs",
    "capture:watch": "node renderer/capture.mjs --watch",
    "capture:test": "node --test renderer/capture.test.mjs api/capture.test.mjs",
    "ppr:test": "node --test tests/ppr.test.mjs",
    "alerts:test": "node --test tests/alerts-image.test.mjs",
    "roku:test": "node --test tests/roku-playlist.test.mjs",
    "capture:install-browser": "playwright install chromium",
    "roku:check": "bsc --project roku/bsconfig.json",
    "roku:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-roku.ps1"
  },
  "dependencies": {
    "@sparticuz/chromium": "149.0.0",
    "@supabase/supabase-js": "2.111.0",
    "dotenv": "17.4.2",
    "playwright": "1.62.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "brighterscript": "0.73.0"
  }
}
